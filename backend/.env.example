# Server Configuration
SERVER_BASE_URL=http://localhost:8080
SERVER_PORT=8080

# URL Behavior
APP_URLS_EXPIRATION_DEFAULT_DAYS=365
APP_URLS_EXPIRATION_MAX_DAYS=365
APP_URLS_SHORT_CODE_MAX_GENERATION_ATTEMPTS=10
APP_URLS_PAGINATION_DEFAULT_PAGE=0
APP_URLS_PAGINATION_DEFAULT_SIZE=10
APP_URLS_PAGINATION_MAX_SIZE=100
APP_URLS_REDIRECT_MAX_CACHE_SECONDS=3600

# Security
JWT_SECRET=replace-with-a-local-secret-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
APP_AUTH_EMAIL_VERIFICATION_ENABLED=false
APP_AUTH_EMAIL_VERIFICATION_EXPIRATION_MINUTES=10
APP_AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
APP_AUTH_EMAIL_VERIFICATION_MAIL_FROM=noreply@shorty.local
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=urlshortener

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_BUCKET_CACHE_MAX_SIZE=100000
RATE_LIMIT_BUCKET_CACHE_EXPIRE_MINUTES=10
RATE_LIMIT_AUTH_CAPACITY=20
RATE_LIMIT_AUTH_REFILL_TOKENS=20
RATE_LIMIT_AUTH_REFILL_MINUTES=1
RATE_LIMIT_PUBLIC_CREATE_CAPACITY=30
RATE_LIMIT_PUBLIC_CREATE_REFILL_TOKENS=30
RATE_LIMIT_PUBLIC_CREATE_REFILL_MINUTES=1
RATE_LIMIT_PUBLIC_REDIRECT_CAPACITY=240
RATE_LIMIT_PUBLIC_REDIRECT_REFILL_TOKENS=240
RATE_LIMIT_PUBLIC_REDIRECT_REFILL_MINUTES=1
RATE_LIMIT_FRONTEND_LOGS_CAPACITY=30
RATE_LIMIT_FRONTEND_LOGS_REFILL_TOKENS=30
RATE_LIMIT_FRONTEND_LOGS_REFILL_MINUTES=1
RATE_LIMIT_AUTHENTICATED_API_CAPACITY=120
RATE_LIMIT_AUTHENTICATED_API_REFILL_TOKENS=120
RATE_LIMIT_AUTHENTICATED_API_REFILL_MINUTES=1

# Cache
CACHE_MAX_SIZE=10000
CACHE_EXPIRE_MINUTES=30
CACHE_NAMES=urlMappings

# Swagger
SWAGGER_ENABLED=true

# Logging
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_MONGODB=WARN
LOG_LEVEL_SPRING_DATA=WARN
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_HTTP_ACCESS=INFO
LOG_SLOW_REQUEST_THRESHOLD_MS=1000
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=30
