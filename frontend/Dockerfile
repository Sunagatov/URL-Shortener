FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_BACKEND_REST_API_URL
ARG VITE_GOOGLE_OAUTH_CLIENT_ID
ARG VITE_TURNSTILE_AUTH_ENABLED=false
ARG VITE_TURNSTILE_SITE_KEY
ARG VITE_TURNSTILE_URL_CREATE_ENABLED=false
ENV VITE_BACKEND_REST_API_URL=${VITE_BACKEND_REST_API_URL}
ENV VITE_GOOGLE_OAUTH_CLIENT_ID=${VITE_GOOGLE_OAUTH_CLIENT_ID}
ENV VITE_TURNSTILE_AUTH_ENABLED=${VITE_TURNSTILE_AUTH_ENABLED}
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}
ENV VITE_TURNSTILE_URL_CREATE_ENABLED=${VITE_TURNSTILE_URL_CREATE_ENABLED}

COPY package*.json ./
RUN npm ci

COPY . .
RUN test -n "$VITE_BACKEND_REST_API_URL" || (echo "VITE_BACKEND_REST_API_URL build arg is required" >&2; exit 1)
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
